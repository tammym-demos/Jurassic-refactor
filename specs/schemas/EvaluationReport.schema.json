{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jurassic.dev/schemas/EvaluationReport.schema.json",
  "title": "Evaluation Report",
  "description": "Quality evaluation report for an agent run, scoring artifact completeness, schema validation, and determinism.",
  "type": "object",
  "required": ["runId", "evaluatedAt", "metrics", "status"],
  "properties": {
    "runId": {
      "type": "string",
      "description": "Unique identifier for the evaluated run.",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "evaluatedAt": {
      "type": "string",
      "description": "ISO-8601 timestamp when the evaluation was performed.",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "description": "Aggregate quality metrics for the run.",
      "required": ["artifactCompleteness", "schemaValidationRate", "determinismScore"],
      "properties": {
        "artifactCompleteness": {
          "type": "number",
          "description": "Fraction of expected artifacts that were produced (0–1).",
          "minimum": 0,
          "maximum": 1
        },
        "schemaValidationRate": {
          "type": "number",
          "description": "Fraction of produced artifacts that pass schema validation (0–1).",
          "minimum": 0,
          "maximum": 1
        },
        "determinismScore": {
          "type": "number",
          "description": "Fraction of artifacts that are byte-identical to a prior run with the same inputs (0–1).",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "description": "Overall evaluation result.",
      "enum": ["pass", "fail", "warning"]
    },
    "details": {
      "type": "array",
      "description": "Per-artifact evaluation results.",
      "items": {
        "type": "object",
        "required": ["artifact", "result"],
        "properties": {
          "artifact": {
            "type": "string",
            "description": "Artifact file name (e.g., Manifest.json)."
          },
          "result": {
            "type": "string",
            "description": "Evaluation result for this artifact.",
            "enum": ["pass", "fail", "missing"]
          },
          "message": {
            "type": "string",
            "description": "Optional explanation for failures or warnings."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
