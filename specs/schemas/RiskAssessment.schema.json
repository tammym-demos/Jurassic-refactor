{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jurassic.dev/schemas/RiskAssessment.schema.json",
  "title": "Risk Assessment",
  "description": "Per-file risk scoring based on weighted factors such as churn, complexity, safety-critical paths, and coverage gaps. Factor weights are defined in the repository profile.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "description": "Risk assessments for individual files.",
      "items": {
        "type": "object",
        "required": ["filePath", "riskScore", "factors"],
        "properties": {
          "filePath": {
            "type": "string",
            "description": "Repository-relative file path."
          },
          "riskScore": {
            "type": "number",
            "description": "Composite risk score, weighted combination of individual factors.",
            "minimum": 0,
            "maximum": 1
          },
          "factors": {
            "type": "object",
            "description": "Individual risk factor scores, each normalized to 0-1.",
            "required": ["churn", "complexity", "safetyPath", "docCoverage", "testCoverage"],
            "properties": {
              "churn": {
                "type": "number",
                "description": "Frequency of recent changes (higher = riskier).",
                "minimum": 0,
                "maximum": 1
              },
              "complexity": {
                "type": "number",
                "description": "Cyclomatic or cognitive complexity score.",
                "minimum": 0,
                "maximum": 1
              },
              "safetyPath": {
                "type": "number",
                "description": "Presence on a safety-critical execution path (e.g. IRQ handlers, watchdogs, fail-safes).",
                "minimum": 0,
                "maximum": 1
              },
              "docCoverage": {
                "type": "number",
                "description": "Inverse documentation coverage (higher = less documented = riskier).",
                "minimum": 0,
                "maximum": 1
              },
              "testCoverage": {
                "type": "number",
                "description": "Inverse test coverage (higher = less tested = riskier).",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "safetyFlags": {
            "type": "array",
            "description": "Safety-critical patterns detected in this file (e.g. IRQHandler, watchdog, emergency_stop).",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
