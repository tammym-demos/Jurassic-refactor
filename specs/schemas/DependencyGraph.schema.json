{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jurassic.dev/schemas/DependencyGraph.schema.json",
  "title": "Dependency Graph",
  "description": "Directed graph of source-level dependencies across a repository, capturing file nodes and their import/include/call edges.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "description": "Source files represented as graph nodes.",
      "items": {
        "type": "object",
        "required": ["path", "type", "language", "loc"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository-relative file path (e.g. Firmware/MotorControl/motor.cpp)."
          },
          "type": {
            "type": "string",
            "description": "Semantic file type.",
            "enum": ["source", "header", "config", "test", "script", "doc", "asset"]
          },
          "language": {
            "type": "string",
            "description": "Primary language of the file (e.g. c, cpp, python, javascript, vue, markdown)."
          },
          "loc": {
            "type": "integer",
            "description": "Lines of code (excluding blanks and comments).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "description": "Directed dependency edges between nodes.",
      "items": {
        "type": "object",
        "required": ["source", "target", "type"],
        "properties": {
          "source": {
            "type": "string",
            "description": "Path of the depending file."
          },
          "target": {
            "type": "string",
            "description": "Path of the dependency target file."
          },
          "type": {
            "type": "string",
            "description": "Kind of dependency relationship.",
            "enum": ["import", "include", "call"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
